generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String  @id
  categoryId  String
  name        String
  description String
  price       Int
  emoji       String  @default("")
  image       String?
  sizes       String?
  isAvailable Boolean @default(true)
  isPopular   Boolean @default(false)
}

model Promo {
  code           String    @id
  kind           String    // "percent" | "fixed"
  value          Int
  minSubtotal    Int       @default(0)
  firstOrderOnly Boolean   @default(false)
  usageLimit     Int       @default(0)
  used           Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Review {
  id         String   @id @default(cuid())
  orderId    String
  customerId String
  kind       String   @default("dish") // "dish" | "delivery"
  dish       String
  courierId  String?
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement())
  customerId     String
  status         String
  courierId      String?
  items          Json
  history        Json     @default("[]")
  deliveryFee    Int
  discount       Int
  paymentMethod  String
  address        String
  addressComment String   @default("")
  comment        String   @default("")
  createdAt      DateTime @default(now())
}

model Cart {
  id    String  @id
  items Json    @default("[]")
  promo String?
}

model Category {
  id    String @id        // "c-pizza": id оставляем как в JSON
  name  String
  slug  String @unique    // "pizza"
  emoji String @default("")
}

model Ingredient {
  id          String  @id   // "i-tomato-sauce"
  name        String
  type        String        // "sauce" | "cheese" | "meat" | "vegetable"
  price       Int           @default(0)
  emoji       String        @default("")
  isAvailable Boolean       @default(true)
}

model User {
  id           String  @id  // "u-customer"
  name         String
  email        String  @unique
  phone        String  @default("")
  role         String       // "customer" | "cook" | "courier" | "manager" | "admin"
  addresses    Json    @default("[]")  // как в users.json
  passwordHash String?      // понадобится для настоящего входа
}